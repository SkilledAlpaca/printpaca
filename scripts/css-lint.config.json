  "scan": [
    ".svelte",
    ".css"
  ],
  "exceptions": [
    {
      "file": "web/src/public/ItemOrderPanel.svelte",
      "selector": ".hero",
      "property": "width",
      "value": "12rem",
      "reason": "Item photo box: a fixed image size beside the text; the plan exempts images."
    },
    {
      "file": "web/src/public/ItemOrderPanel.svelte",
      "selector": ".lightbox",
      "property": "max-width",
      "value": "min(92vw, 48rem)",
      "reason": "Enlarged-photo dialog width: a viewport-relative image bound; the plan exempts images."
    },
    {
      "file": "web/src/components/PrintView.svelte",
      "selector": ".logo",
      "property": "max-width",
      "value": "240px",
      "reason": "Business logo bound on the printed quote: an image size the plan exempts, and print output must match v1.1."
    },
    {
      "file": "web/src/components/PrintView.svelte",
      "selector": ".seller p",
      "property": "margin",
      "value": "0.1rem 0",
      "reason": "Printed seller-block line spacing kept at the v1.1 value so the printed quote is unchanged; the screen scale has no step this small."
    },
    {
      "file": "web/src/components/PrintView.svelte",
      "selector": "td, th",
      "property": "padding",
      "value": "0.35rem var(--space-2)",
      "reason": "Printed table cell padding kept at the v1.1 value so the printed quote is unchanged; the screen scale has no step this size."
    }
  ]
}
