{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "printpaca configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
        "code": { "type": "string", "pattern": "^([A-Z]{3})?$" }
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["margin", "markup"] },
        "marginPct": { "type": "number", "minimum": 0, "maximum": 99.9 },
        "markupMultiplier": { "type": "number", "minimum": 0, "maximum": 10000 },
        "taxRatePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "defaultShippingCost": { "type": "number", "minimum": 0 },
        "defaultShippingCharge": { "type": "number", "minimum": 0 },
        "defaultFeeSchedule": { "type": "string" },
        "laborPerUnit": { "type": "boolean" }
      }
    },
    "feeSchedules": {
      "type": "object",
      "maxProperties": 200,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "source": { "type": "string" },
          "fixed": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "properties": { "amount": { "type": "number", "minimum": 0 }, "label": { "type": "string" } },
              "required": ["amount", "label"]
            }
          },
          "percent": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "base": { "enum": ["revenue"] },
                "label": { "type": "string" }
              },
              "required": ["pct", "base", "label"]
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "density": { "type": "number", "exclusiveMinimum": 0 },
          "pricePerKg": { "type": "number", "minimum": 0 },
          "wastePct": { "type": "number", "minimum": 0, "maximum": 100 },
          "public": { "type": "boolean" }
        },
        "required": ["id", "name", "density", "pricePerKg"]
      }
    },
    "printers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "watts": { "type": "number", "minimum": 0 },
          "purchaseCost": { "type": "number", "minimum": 0 },
          "lifespanHours": { "type": "number", "minimum": 0 },
          "filamentDiameterMm": { "type": "number", "exclusiveMinimum": 0 }
        },
        "required": ["id", "name", "watts", "purchaseCost", "lifespanHours", "filamentDiameterMm"]
      }
    },
    "hardware": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "unitCost": { "type": "number", "minimum": 0 },
          "lostOnFailure": { "type": "boolean" }
        },
        "required": ["name", "unitCost"]
      }
    },
    "energy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["flat", "tou", "schedule"] },
        "flatRate": { "type": "number", "minimum": 0 },
        "tou": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "peakRate": { "type": "number", "minimum": 0 },
            "offPeakRate": { "type": "number", "minimum": 0 },
            "defaultOffPeakFrac": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "schedule": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "defaultStartTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "holidays": {
              "type": "array", "maxItems": 100,
              "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "seasons": {
              "type": "array", "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 }, "uniqueItems": true },
                  "weekday": {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                      "baseName": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "baseRate": { "type": "number", "minimum": 0 },
                      "windows": {
                        "type": "array", "maxItems": 8,
                        "items": {
                          "type": "object", "additionalProperties": false,
                          "properties": {
                            "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                            "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                            "end": { "type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" },
                            "rate": { "type": "number", "minimum": 0 }
                          }
                        }
                      }
                    }
                  },
                  "weekend": {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                      "baseName": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "baseRate": { "type": "number", "minimum": 0 },
                      "windows": {
                        "type": "array", "maxItems": 8,
                        "items": {
                          "type": "object", "additionalProperties": false,
                          "properties": {
                            "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                            "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                            "end": { "type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" },
                            "rate": { "type": "number", "minimum": 0 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "presets": {
      "type": "object",
      "maxProperties": 200,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "failureRatePct": { "type": "number", "minimum": 0, "maximum": 90 },
          "prepMinutes": { "type": "number", "minimum": 0 },
          "laborRate": { "type": "number", "minimum": 0 },
          "monthlyFixed": { "type": "number", "minimum": 0 },
          "monthlyHours": { "type": "number", "minimum": 0 }
        }
      }
    },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preset": { "type": "string" }, "printer": { "type": "string" },
        "material": { "type": "string" },
        "failureRatePct": { "type": "number", "minimum": 0, "maximum": 90 },
        "quantity": { "type": "integer", "minimum": 1 }
      }
    },
    "quote": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "businessName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "taxId": { "type": "string" },
        "paymentInstructions": { "type": "string", "maxLength": 2000 },
        "termsText": { "type": "string", "maxLength": 2000 },
        "validDays": { "type": "integer", "minimum": 0 },
        "referencePrefix": { "type": "string", "pattern": "^([A-Za-z0-9]{1,10})?$" }
      }
    },
    "invoicing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "numberPrefix": { "type": "string", "pattern": "^[A-Za-z0-9]{1,10}$" },
        "salesTaxPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "dueDays": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "paymentMethods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 50 }
        },
        "paypalMe": { "type": "string", "pattern": "^([A-Za-z0-9]{1,20})?$" }
      }
    },
    "publicQuotes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "printer": { "type": "string" },
        "preset": { "type": "string" },
        "introText": { "type": "string", "maxLength": 500 }
      }
    },
    "timezone": { "type": "string", "minLength": 1 },
    "customCss": { "type": "string", "maxLength": 32768 },
    "smtp": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "requireTLS": { "type": "boolean" }
      }
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "disabledTabs": {
          "type": "array",
          "items": {
            "enum": [
              "quotes", "requests", "invoices", "items", "clients", "dashboard",
              "filament", "electricity", "printers", "guide"
            ]
          }
        }
      }
    },
    "integrationsUrls": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "spoolmanUrl": { "type": "string" },
        "moonrakerUrl": { "type": "string" },
        "fluiddUrl": { "type": "string" }
      }
    },
    "users": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "multiUser": {
          "type": "boolean",
          "description": "Enables employee accounts and per-tab permissions. Requires ADMIN_PASSWORD to be set."
        },
        "accessAdminEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "The Cloudflare Access email that signs in as the admin in multi-user mode. Optional; stored lowercased."
        }
      }
    },
    "site": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "shopOnMainPort": {
          "type": "boolean",
          "description": "Serve the shop (/ and /order) and the public API on PORT. When false, / redirects to /admin/ and the public routes return 404 on PORT. PUBLIC_PORT is unaffected."
        },
        "staffLink": {
          "type": "boolean",
          "description": "Show the Staff sign-in link in the footer of the shop served on PORT."
        },
        "adminUrl": {
          "type": "string",
          "description": "Absolute http or https URL of the admin app, the Staff sign-in target in the footer of the shop on PUBLIC_PORT. Empty hides the link there."
        }
      }
    },
    "shop": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxOrderQty": {
          "type": "integer", "minimum": 1, "maximum": 10000,
          "description": "The largest quantity one public estimate request or gallery order may carry. Default 100."
        },
        "customEstimates": {
          "type": "boolean",
          "description": "Offer the custom estimate flow. When false the shop hides it and the server rejects estimate previews and submissions. You can't turn off both this and the gallery. Default true."
        },
        "gallery": {
          "type": "boolean",
          "description": "Offer the item gallery. When false the shop shows only the custom estimate and the server rejects item orders. Default true."
        },
        "acceptingOrders": {
          "type": "boolean",
          "description": "Accept new orders and estimates (vacation mode when false: the shop stays visible, pausedMessage replaces the submit buttons, the server rejects new submissions). Default true."
        },
        "pausedMessage": {
          "type": "string", "maxLength": 300,
          "description": "Plain-text message shown instead of the submit buttons when acceptingOrders is false. Empty uses a default."
        },
        "defaultView": {
          "type": "string", "enum": ["gallery", "estimate"],
          "description": "Which view the shop opens on when both the gallery and custom estimates are on. Default gallery."
        },
        "pageTitle": {
          "type": "string", "maxLength": 70,
          "description": "Plain-text browser tab title. Empty uses the business name, then Shop."
        },
        "heading": {
          "type": "string", "maxLength": 120,
          "description": "Plain-text heading above the intro. Empty uses the business name."
        },
        "announcement": {
          "type": "string", "maxLength": 300,
          "description": "Plain-text banner at the top of the shop, for notices such as holiday shipping cutoffs."
        },
        "heroImage": {
          "type": "object", "additionalProperties": false,
          "description": "Optional banner image. Set it with the Settings upload (stored like item photos); a settings save keeps the stored file and takes only alt.",
          "properties": {
            "file": { "type": "string", "pattern": "^([0-9a-f]{16}\\.(jpg|png|webp))?$" },
            "alt": { "type": "string", "maxLength": 200, "description": "Required when file is set." }
          }
        },
        "accentColor": {
          "type": "string", "pattern": "^(#[0-9a-fA-F]{6})?$",
          "description": "Accent for buttons and links in the shop, as #rrggbb. Must reach 4.5:1 contrast against the shop backgrounds (as link text and as a button background with its label); printpaca derives the dark-mode variant. Empty uses the theme accent."
        },
        "showStock": {
          "type": "boolean",
          "description": "Show stock counts on items. Default true."
        },
        "showFromPrice": {
          "type": "boolean",
          "description": "Show \"from\" prices on items with options. Default true."
        },
        "itemSort": {
          "type": "string", "enum": ["manual", "name", "price"],
          "description": "Gallery order: your manual order, by name, or by price. Featured items always come first. Default manual."
        },
        "footerLinks": {
          "type": "array", "maxItems": 6,
          "description": "Up to 6 links in the shop footer.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "url": { "type": "string", "pattern": "^https://", "maxLength": 500 }
            }
          }
        },
        "showContact": {
          "type": "boolean",
          "description": "Show your email, phone, and address in the shop. Default true."
        },
        "shippingNote": {
          "type": "string", "maxLength": 300,
          "description": "Plain-text note replacing the fixed shipping wording next to the total and on confirmations. Empty keeps today's text."
        },
        "turnaroundNote": {
          "type": "string", "maxLength": 300,
          "description": "Plain-text note replacing the fixed turnaround wording. Empty keeps today's text."
        }
      }
    }
  }
}
