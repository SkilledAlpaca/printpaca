{
  "blocking": [
    "web/src/components/ui/**",
    "web/src/public/ItemOrderPanel.svelte",
    "web/src/components/RequestsTab.svelte",
    "web/src/components/QuoteTab.svelte",
    "web/src/components/PartsList.svelte",
    "web/src/components/PartsTable.svelte",
    "web/src/components/PricingPanel.svelte",
    "web/src/components/QuoteSummaryBar.svelte",
    "web/src/components/BreakdownTable.svelte",
    "web/src/components/RecentPrints.svelte",
    "web/src/components/PrintStartFields.svelte",
    "web/src/components/SpoolPicker.svelte",
    "web/src/components/GcodeDrop.svelte",
    "web/src/components/PresetChips.svelte",
    "web/src/components/LabeledNumber.svelte",
    "web/src/components/LabeledText.svelte",
    "web/src/components/PrintView.svelte",
    "web/src/components/HistoryPanel.svelte"
  ],
  "scan": [
    ".svelte",
    ".css"
  ],
  "exceptions": [
    {
      "file": "web/src/components/RequestsTab.svelte",
      "selector": ".menu-panel",
      "property": "min-width",
      "value": "11rem",
      "reason": "Width of the Requests list's more-actions popout; the list view moves to ui/ components in the Money slice."
    },
    {
      "file": "web/src/components/RequestsTab.svelte",
      "selector": ".check-label input",
      "property": "width",
      "value": "1.25rem",
      "reason": "Size of the row-select checkbox glyph (a control, not layout); revisit with the list-view migration."
    },
    {
      "file": "web/src/public/ItemOrderPanel.svelte",
      "selector": ".hero",
      "property": "width",
      "value": "12rem",
      "reason": "Item photo box: a fixed image size beside the text; the plan exempts images."
    },
    {
      "file": "web/src/public/ItemOrderPanel.svelte",
      "selector": ".lightbox",
      "property": "max-width",
      "value": "min(92vw, 48rem)",
      "reason": "Enlarged-photo dialog width: a viewport-relative image bound; the plan exempts images."
    },
    {
      "file": "web/src/components/PrintView.svelte",
      "selector": ".logo",
      "property": "max-width",
      "value": "240px",
      "reason": "Business logo bound on the printed quote: an image size the plan exempts, and print output must match v1.1."
    },
    {
      "file": "web/src/components/PrintView.svelte",
      "selector": ".seller p",
      "property": "margin",
      "value": "0.1rem 0",
      "reason": "Printed seller-block line spacing kept at the v1.1 value so the printed quote is unchanged; the screen scale has no step this small."
    },
    {
      "file": "web/src/components/PrintView.svelte",
      "selector": "td, th",
      "property": "padding",
      "value": "0.35rem var(--space-2)",
      "reason": "Printed table cell padding kept at the v1.1 value so the printed quote is unchanged; the screen scale has no step this size."
    }
  ]
}
