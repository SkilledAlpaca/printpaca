{
  "blocking": [
    "web/src/components/ui/**",
    "web/src/public/ItemOrderPanel.svelte",
    "web/src/components/RequestsTab.svelte",
    "web/src/components/InvoicesTab.svelte",
    "web/src/components/invoices/**",
    "web/src/components/QuotesTab.svelte",
    "web/src/components/ClientsTab.svelte",
    "web/src/components/DashboardTab.svelte",
    "web/src/App.svelte",
    "web/src/public/PublicQuotePage.svelte",
    "web/src/public/ItemGallery.svelte",
    "web/src/public/PublicFooter.svelte",
    "web/src/public/ClosedPage.svelte",
    "web/src/public/ContactDetails.svelte",
    "web/src/public/CategoryChips.svelte",
    "web/src/public/ShopHero.svelte",
    "web/src/public/FormErrorSummary.svelte",
    "web/src/public/RateLimitNotice.svelte",
    "web/src/public/PublicApp.svelte"
  ],
  "scan": [
    ".svelte",
    ".css"
  ],
  "exceptions": [
    {
      "file": "web/src/public/ItemOrderPanel.svelte",
      "selector": ".hero",
      "property": "width",
      "value": "12rem",
      "reason": "Item photo box: a fixed image size beside the text; the plan exempts images."
    },
    {
      "file": "web/src/public/ItemOrderPanel.svelte",
      "selector": ".lightbox",
      "property": "max-width",
      "value": "min(92vw, 48rem)",
      "reason": "Enlarged-photo dialog width: a viewport-relative image bound; the plan exempts images."
    },
    {
      "file": "web/src/App.svelte",
      "selector": ".sidebar",
      "property": "width",
      "value": "min(280px, 85vw)",
      "reason": "Phone drawer width: a viewport-relative panel, not content layout; no token covers a navigation rail."
    },
    {
      "file": "web/src/App.svelte",
      "selector": ".sidebar",
      "property": "width",
      "value": "220px",
      "reason": "Desktop sidebar rail width; no token covers a navigation rail."
    },
    {
      "file": "web/src/App.svelte",
      "selector": ".sidebar.collapsed",
      "property": "width",
      "value": "64px",
      "reason": "Collapsed (icon-only) rail width; fits one 40px control plus padding."
    },
    {
      "file": "web/src/components/RequestsTab.svelte",
      "selector": ".menu-panel",
      "property": "min-width",
      "value": "11rem",
      "reason": "Width of the Requests list's more-actions popout; the list view moves to ui/ components in the Money slice."
    },
    {
      "file": "web/src/components/RequestsTab.svelte",
      "selector": ".check-label input",
      "property": "width",
      "value": "1.25rem",
      "reason": "Size of the row-select checkbox glyph (a control, not layout); revisit with the list-view migration."
    }
  ]
}
